[Unit]
Description=Claude Inbox Watcher (inbox/ → tmux)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/eric/code/claude-telegram-router
EnvironmentFile=/home/eric/code/claude-telegram-router/.env
ExecStart=/home/eric/code/claude-telegram-router/.venv/bin/python -m scripts.inbox_watcher
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
