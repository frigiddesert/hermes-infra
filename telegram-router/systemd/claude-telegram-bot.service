[Unit]
Description=Claude Telegram Router Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/eric/code/openclaw/telegram-router
EnvironmentFile=/home/eric/code/openclaw/telegram-router/.env
ExecStart=/home/eric/code/openclaw/telegram-router/.venv/bin/python -m telegram_bot.bot
Restart=always
StartLimitIntervalSec=0
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
